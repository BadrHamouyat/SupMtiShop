@startuml
start
:Client consulte produits;
:Ajoute produit au panier;
:Ouvre panier;
if (Panier vide ?) then (oui)
  :Afficher message panier vide;
  stop
else (non)
  :Remplir formulaire checkout;
  :Choisir mode paiement;
  if (Paiement en ligne ?) then (oui)
    :Saisir informations carte demo;
    :Valider paiement simulé;
    :Commande payée;
  else (non)
    :Paiement à la livraison;
    :Commande en attente;
  endif
  :Sauvegarder commande;
  :Afficher confirmation;
endif
stop
@enduml
