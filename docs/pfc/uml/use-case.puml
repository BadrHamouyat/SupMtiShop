@startuml
left to right direction
skinparam packageStyle rectangle
actor "Visiteur" as Visitor
actor "Client" as Client
actor "Administrateur" as Admin

rectangle "SupMtiShop" {
  usecase "Consulter catalogue" as UC1
  usecase "Rechercher produit" as UC2
  usecase "Créer compte" as UC3
  usecase "Se connecter" as UC4
  usecase "Ajouter au panier" as UC5
  usecase "Passer commande" as UC6
  usecase "Choisir paiement" as UC7
  usecase "Consulter commandes" as UC8
  usecase "Ajouter avis" as UC9
  usecase "Gérer produits" as UC10
  usecase "Uploader image" as UC11
  usecase "Gérer commandes" as UC12
  usecase "Gérer utilisateurs" as UC13
  usecase "Consulter dashboard" as UC14
}

Visitor --> UC1
Visitor --> UC2
Visitor --> UC3
Visitor --> UC4
Client --> UC5
Client --> UC6
Client --> UC7
Client --> UC8
Client --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
UC6 .> UC7 : include
UC10 .> UC11 : include
@enduml
