@startuml
skinparam classAttributeIconSize 0
class Utilisateur {
  +id: number
  +name: string
  +email: string
  +passwordHash: string
  +role: string
  +createdAt: date
}

class Client {
  +consulterProduits()
  +ajouterAuPanier()
  +passerCommande()
  +ajouterAvis()
}

class Administrateur {
  +gererProduits()
  +gererCommandes()
  +gererUtilisateurs()
  +consulterDashboard()
}

class Produit {
  +id: number
  +title: string
  +description: string
  +category: string
  +price: number
  +oldPrice: number
  +stock: number
  +image: string
  +discountPercent: number
  +rating: number
}

class Commande {
  +id: number
  +reference: string
  +userId: number
  +items: array
  +total: number
  +status: string
  +paymentMethod: string
  +paymentStatus: string
  +createdAt: date
}

class Avis {
  +id: number
  +productId: number
  +userId: number
  +rating: number
  +comment: string
  +createdAt: date
}

Utilisateur <|-- Client
Utilisateur <|-- Administrateur
Client "1" --> "0..*" Commande
Client "1" --> "0..*" Avis
Produit "1" --> "0..*" Avis
Commande "1" --> "1..*" Produit
Administrateur --> Produit : gère
Administrateur --> Commande : met à jour
@enduml
