<div class="shopbot" data-shopbot>
  <button class="shopbot-toggle" type="button" data-shopbot-toggle aria-expanded="false">
    <span class="shopbot-toggle-icon">💬</span>
    <span>Assistant produit</span>
  </button>

  <section class="shopbot-window" data-shopbot-window hidden aria-label="Assistant produit SupMtiShop">
    <div class="shopbot-head">
      <div>
        <strong>Assistant SupMtiShop</strong>
        <span>Je vous aide à trouver un produit</span>
      </div>
      <button class="shopbot-close" type="button" data-shopbot-close aria-label="Fermer l'assistant">×</button>
    </div>

    <div class="shopbot-messages" data-shopbot-messages>
      <div class="shopbot-msg bot">
        Bonjour 👋 Je peux vous aider à trouver rapidement un produit. Essayez : <strong>casque gaming</strong>, <strong>produit moins de 500 DH</strong>, <strong>promotions</strong> ou choisissez une suggestion.
      </div>
      <div class="shopbot-chips">
        <button type="button" data-shopbot-chip="promotions">Promotions</button>
        <button type="button" data-shopbot-chip="produits gaming">Gaming</button>
        <button type="button" data-shopbot-chip="accessoires audio">Accessoires audio</button>
        <button type="button" data-shopbot-chip="maison moins de 300 DH">Maison -300 DH</button>
        <button type="button" data-shopbot-chip="produits disponibles">En stock</button>
        <button type="button" data-shopbot-chip="top ventes">Top ventes</button>
      </div>
    </div>

    <form class="shopbot-form" data-shopbot-form>
      <input type="text" data-shopbot-input placeholder="Ex: casque en stock" autocomplete="off" required>
      <button type="submit">Envoyer</button>
    </form>
  </section>
</div>

<script src="/js/app.js"></script>
