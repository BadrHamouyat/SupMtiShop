<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SupMtiShop | Boutique en ligne moderne</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <div class="container">
      <span>SupMtiShop • Offres exclusives chaque jour • Livraison rapide • Retours faciles</span>
      <a class="topbar-link" href="https://wa.me/212762878817" target="_blank" rel="noopener">Support WhatsApp: +212 762 878 817</a>
    </div>
  </div>

  <nav class="nav nav-modern">
    <div class="container nav-inner nav-inner-modern">
      <a class="logo logo-image brand-card" href="/" aria-label="SupMtiShop">
        <img src="/images/supmtishop-logo.png" alt="SupMtiShop">
      </a>

      <button class="mobile-menu-btn" type="button" data-nav-toggle aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>

      <form class="searchbar searchbar-modern" method="GET" action="/products">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input type="search" name="q" placeholder="Rechercher produits, catégories, accessoires..." value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>">
        <button type="submit">Chercher</button>
      </form>

      <div class="nav-actions nav-actions-modern" data-nav-menu>
        <div class="nav-shop-tools" data-nav-tools>
        <div class="category-mega" data-category-mega>
          <button class="category-mega-trigger" type="button" data-category-mega-trigger aria-expanded="false">
            <span class="category-mega-icon" aria-hidden="true">☰</span>
            <span>Catégories</span>
            <strong aria-hidden="true">⌄</strong>
          </button>

          <div class="category-mega-panel" data-category-mega-panel hidden>
            <div class="category-mega-side">
              <a class="category-side-link featured" href="/products">Toutes les catégories <span>›</span></a>
              <% (navCategories || []).forEach(function(cat){ %>
                <a class="category-side-link" href="/products?category=<%= encodeURIComponent(cat.name) %>">
                  <span><%= cat.icon || '🛒' %> <%= cat.name %></span>
                  <small><%= cat.count || 0 %></small>
                </a>
              <% }) %>
            </div>

            <div class="category-mega-content">
              <div class="category-mega-title">
                <strong>Explorer par catégorie</strong>
                <span>Choisissez une famille de produits pour filtrer rapidement le catalogue.</span>
              </div>
              <div class="category-mega-grid">
                <% (navCategories || []).forEach(function(cat){ %>
                  <a class="category-mega-item" href="/products?category=<%= encodeURIComponent(cat.name) %>">
                    <span class="category-mega-thumb">
                      <% if (cat.image) { %>
                        <img src="<%= cat.image %>" alt="<%= cat.name %>">
                      <% } else { %>
                        <em><%= cat.icon || '🛒' %></em>
                      <% } %>
                      <% if (cat.hot) { %><b>HOT</b><% } %>
                    </span>
                    <span class="category-mega-name"><%= cat.name %></span>
                  </a>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
        </div>

        <a class="nav-link" href="/cart"><span class="nav-ico">🛒</span><span class="nav-text">Panier</span><% if (cartCount) { %><span class="count-badge"><%= cartCount %></span><% } %></a>
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a class="nav-link highlight" href="/admin"><span class="nav-ico">⚙️</span><span class="nav-text">Admin</span></a>
          <% } else { %>
            <a class="nav-link" href="/wishlist"><span class="nav-ico">♡</span><span class="nav-text">Favoris</span><% if (wishlistCount) { %><span class="count-badge"><%= wishlistCount %></span><% } %></a>
            <a class="nav-link" href="/orders"><span class="nav-ico">📦</span><span class="nav-text">Commandes</span></a>
            <a class="nav-link" href="/profile"><span class="nav-ico">👤</span><span class="nav-text">Profil</span></a>
          <% } %>
          <form class="logout-inline" action="/logout" method="POST">
            <button class="nav-link nav-link-danger" type="submit"><span class="nav-ico">⏻</span><span class="nav-text">Déconnexion</span></button>
          </form>
        <% } else { %>
          <a class="nav-link" href="/login"><span class="nav-ico">🔐</span><span class="nav-text">Connexion</span></a>
          <a class="nav-link highlight" href="/register"><span class="nav-ico">✨</span><span class="nav-text">Créer un compte</span></a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container flash">
    <% const flashMessages = (typeof messages !== 'undefined' && messages) ? messages : { success: [], error: [] }; %>
    <% (flashMessages.success || []).forEach(function(msg){ %>
      <div class="success"><%= msg %></div>
    <% }) %>
    <% (flashMessages.error || []).forEach(function(msg){ %>
      <div class="error"><%= msg %></div>
    <% }) %>
  </div>
