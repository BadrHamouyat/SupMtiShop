<%- include('partials/header') %>

<main class="container">
  <div class="section-head">
    <div>
      <h2>Finaliser la commande</h2>
      <p>Choisissez le mode de paiement, la livraison par ville et validez les conditions.</p>
    </div>
  </div>

  <div class="checkout-grid">
    <form class="card" action="/checkout" method="POST">
      <div class="form-grid">
        <div>
          <label>Nom complet</label>
          <input class="input" name="fullName" required value="<%= user.name || currentUser.name %>">
        </div>
        <div>
          <label>Téléphone</label>
          <input class="input" name="phone" required placeholder="06 00 00 00 00" value="<%= user.phone || '' %>">
        </div>
        <div>
          <label>Ville</label>
          <select name="city" id="citySelect" required>
            <% const cities = ['Taourirt','Oujda','Rabat','Casablanca','Fès','Marrakech','Tanger','Agadir','Autre ville']; %>
            <% cities.forEach(function(city){ %>
              <option value="<%= city %>" <%= (user.city || selectedCity) === city ? 'selected' : '' %>><%= city %></option>
            <% }) %>
          </select>
          <small class="form-help">Livraison estimée selon la ville.</small>
        </div>
        <div>
          <label>Code promo</label>
          <input class="input" name="couponCode" placeholder="SUPMTI10, WELCOME20, LIVRAISON" value="<%= couponCode || '' %>">
          <small class="form-help">Coupons disponibles : SUPMTI10, WELCOME20, LIVRAISON</small>
        </div>
        <div>
          <label>Mode de paiement</label>
          <select name="paymentMethod" id="paymentMethod" required>
            <option value="cash">Paiement à la livraison</option>
            <option value="online">Paiement en ligne</option>
          </select>
        </div>
        <div class="full online-payment-fields" id="onlinePaymentFields">
          <div class="online-payment-head">
            <strong>💳 Paiement en ligne sécurisé</strong>
            <span>Total estimé: <%= formatPrice(total) %></span>
          </div>
          <div class="form-grid compact-grid">
            <div><label>Nom sur la carte</label><input class="input" name="cardName" placeholder="Badr Hamouyat" data-online-field></div>
            <div><label>Numéro de carte</label><input class="input" name="cardNumber" inputmode="numeric" placeholder="4242 4242 4242 4242" data-online-field></div>
            <div><label>Expiration</label><input class="input" name="cardExpiry" placeholder="MM/AA" data-online-field></div>
            <div><label>CVV</label><input class="input" name="cardCvc" inputmode="numeric" placeholder="123" data-online-field></div>
          </div>
          <p class="muted secure-note">Les données complètes de la carte ne sont pas enregistrées dans la base JSON.</p>
        </div>
        <div class="full">
          <label>Adresse complète</label>
          <textarea name="address" required placeholder="Adresse, quartier, numéro..."><%= user.address || '' %></textarea>
        </div>
        <label class="full terms-line"><input type="checkbox" name="acceptTerms" required> J'accepte les conditions de vente, livraison et retour.</label>
      </div>
      <br>
      <button class="btn orange" type="submit">Confirmer la commande</button>
    </form>

    <div class="card">
      <h2>Résumé</h2>
      <% items.forEach(function(item){ %>
        <div class="summary-line">
          <span><%= item.qty %> × <%= item.product.title %></span>
          <strong><%= formatPrice(item.subtotal) %></strong>
        </div>
      <% }) %>
      <div class="summary-line"><span>Livraison estimée</span><strong><%= shipping ? formatPrice(shipping) : 'Gratuite' %></strong></div>
      <div class="summary-line"><span>Réduction automatique</span><strong>- <%= formatPrice(autoDiscount || 0) %></strong></div>
      <div class="summary-line"><span>Coupon <%= coupon ? coupon.code : '' %></span><strong>- <%= formatPrice(couponDiscount || 0) %></strong></div>
      <% if (coupon) { %><div class="notice coupon-notice">🎁 Coupon appliqué : <%= coupon.description %></div><% } %>
      <div class="summary-line total"><span>Total estimé</span><strong><%= formatPrice(total) %></strong></div>
      <div class="delivery-table">
        <h3>Prix livraison</h3>
        <p>Taourirt/Oujda: 20 DH · Grandes villes: 35/40 DH · Autres villes: 45 DH · Gratuit dès 1000 DH.</p>
      </div>
      <div class="notice">Après confirmation, vous recevrez le résumé de votre commande, le suivi et la facture PDF.</div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
